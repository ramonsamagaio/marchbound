[gd_scene format=3]

[node name="CommandCenterHybrid" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 22.0
offset_top = 16.0
offset_right = -22.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 2

[node name="Root" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Left" type="VBoxContainer" parent="Margin/Root"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 9

[node name="Header" type="HBoxContainer" parent="Margin/Root/Left"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Root/Left/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "DAWNKEEP COMMAND"

[node name="Spacer" type="Control" parent="Margin/Root/Left/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Location" type="Label" parent="Margin/Root/Left/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Warden location"

[node name="Intro" type="Label" parent="Margin/Root/Left"]
layout_mode = 2
text = "Dawnkeep is a real HOME AREA. This screen is command and administration, not a fictional city substitute."
autowrap_mode = 2

[node name="SummaryPanel" type="PanelContainer" parent="Margin/Root/Left"]
layout_mode = 2

[node name="Summary" type="VBoxContainer" parent="Margin/Root/Left/SummaryPanel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="BodyScroll" type="ScrollContainer" parent="Margin/Root/Left"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Margin/Root/Left/BodyScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Side" type="PanelContainer" parent="Margin/Root"]
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
size_flags_vertical = 3

[node name="SideMargin" type="MarginContainer" parent="Margin/Root/Side"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 14

[node name="Actions" type="VBoxContainer" parent="Margin/Root/Side/SideMargin"]
layout_mode = 2
theme_override_constants/separation = 9
